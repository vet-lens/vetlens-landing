---
import SiteLayout from './SiteLayout.astro';

const { frontmatter = {} } = Astro.props;
const pageTitle = frontmatter.title || 'VET lens — Escanea y conoce tus medicamentos veterinarios';
const defaultSeoTitle = 'VET lens — Escanea y conoce tus medicamentos veterinarios';
---
<SiteLayout
  title={pageTitle}
  seoTitle={frontmatter.title || defaultSeoTitle}
  description={frontmatter.description}
  image={frontmatter.image}
  imageAlt={frontmatter.imageAlt}
  metaType={frontmatter.metaType}
  schemaType={frontmatter.schemaType || 'WebPage'}
>
  <main class="document-main">
    <article class="prose">
      <slot />
    </article>
  </main>
</SiteLayout>
