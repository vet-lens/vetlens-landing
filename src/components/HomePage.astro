---
import SiteLayout from '@/layouts/SiteLayout.astro';
import vetlensIcon from '@/assets/icons/vetlens.svg?no-inline';
import Sponsorship from './Sponsorship.astro';
import Features from './Features.astro';
import FrequentlyAskedQuestions from './FrequentlyAskedQuestions.astro';
import PressNews from './PressNews.astro';
---
<SiteLayout title="VET lens — Escanea y conoce tus medicamentos veterinarios" seoTitle="VET lens — Escanea y conoce tus medicamentos veterinarios" description="VET lens prepara una nueva forma de consultar información oficial sobre medicamentos veterinarios. La app está en desarrollo.">
<main>
  <section class="home-hero">
    <div class="hero-copy">
      <div class="hero-title-group">
        <p class="hero-brand"><span class="hero-brand-primary">VET</span> <span class="hero-brand-accent">lens</span></p>
        <h1>Escanea y conoce tus medicamentos veterinarios</h1>
      </div>
      <p class="hero-tagline">Estamos preparando una app para consultar información oficial sobre medicamentos veterinarios, con datos organizados por especie y presentación.</p>
      <p class="launch-status"><i class="ph ph-hammer" aria-hidden="true"></i><strong>Próximamente</strong><span>La app está en desarrollo.</span></p>
      <div class="hero-notes" aria-label="Información del proyecto">
        <span class="hero-note"><i class="ph ph-shield-check" aria-hidden="true"></i> Datos del registro oficial CIMA Vet</span>
        <span class="hero-note"><i class="ph ph-paw-print" aria-hidden="true"></i> Medicamentos veterinarios</span>
      </div>
    </div>
    <div class="hero-media">
      <div class="hero-image-glow" aria-hidden="true"></div>
      <figure class="vetlens-abstract-visual">
        <div class="vetlens-abstract-art" aria-hidden="true">
          <span class="abstract-halo"></span>
          <span class="abstract-orbit abstract-orbit-wide"></span>
          <span class="abstract-orbit abstract-orbit-tall"></span>
          <span class="abstract-orbit-dot abstract-orbit-dot-one"></span>
          <span class="abstract-orbit-dot abstract-orbit-dot-two"></span>
          <span class="abstract-node abstract-node-species"><i class="ph ph-paw-print"></i></span>
          <span class="abstract-node abstract-node-care"><i class="ph ph-first-aid-kit"></i></span>
          <span class="abstract-node abstract-node-data"><i class="ph ph-shield-check"></i></span>
          <span class="abstract-source"><i class="ph ph-shield-check"></i> CIMA Vet</span>
          <span class="abstract-logo"><img src={vetlensIcon} alt="" width="210" height="210" /></span>
        </div>
        <figcaption class="visually-hidden">Ilustración abstracta de VET lens: su símbolo rodeado de elementos que representan el cuidado veterinario, las especies y los datos oficiales.</figcaption>
      </figure>
    </div>
  </section>
  <Features />
  <section class="custom-home-content"><FrequentlyAskedQuestions />
    <Sponsorship />
    <PressNews />
    {/* Newsletter desactivada hasta configurar un servicio para VET lens. */}
  </section>
  <section class="related-app-section" aria-labelledby="related-app-title">
    <article class="related-app-card">
      <div class="related-app-copy">
        <span class="page-eyebrow">También del equipo</span>
        <h2 id="related-app-title">¿Buscas información sobre medicamentos de uso humano?</h2>
        <p>Conoce <span class="logo-colored medilens-logo-colored">MEDI lens</span>, nuestra app para consultar información sobre medicamentos para personas.</p>
      </div>
      <a class="custom-button related-app-link" href="https://medilens.es" target="_blank" rel="noopener noreferrer">
        Descubre MEDI lens <i class="ph ph-arrow-square-out" aria-hidden="true"></i>
      </a>
    </article>
  </section>
</main></SiteLayout>
