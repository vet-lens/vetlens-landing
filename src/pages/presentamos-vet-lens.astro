---
import SiteLayout from '@/layouts/SiteLayout.astro';
// <StoreBadges placement="presentation" /> se habilitará al publicarse la app.
const searchMethods = ['Nombre del medicamento', 'Laboratorio titular', 'Principio activo', 'Número de registro', 'Código nacional', 'Código ATCvet', 'Especie de destino', 'Forma farmacéutica'];
const medicineDetails = [
  { icon: 'ph-identification-card', title: 'Identificación', items: ['Nombre del medicamento', 'Número de registro y código nacional', 'Titular de la autorización', 'Principios activos y excipientes', 'Presentaciones disponibles'] },
  { icon: 'ph-file-text', title: 'Documentación oficial', items: ['Ficha técnica veterinaria', 'Prospecto', 'Notas de seguridad o informativas', 'Documentos publicados por la AEMPS'] },
  { icon: 'ph-paw-print', title: 'Uso por especie', items: ['Especies de destino', 'Indicaciones asociadas a cada especie', 'Vías de administración', 'Condiciones de dispensación y administración'] },
  { icon: 'ph-shield-check', title: 'Seguridad y situación', items: ['Contraindicaciones e interacciones', 'Reacciones adversas', 'Tiempos de espera por especie y tejido', 'Estado de autorización y comercialización', 'Condición de receta, antibiótico, psicótropo o estupefaciente'] },
];
---
<SiteLayout title="Presentación" seoTitle="Presentación de VET lens" description="Conoce VET lens, una app en desarrollo para consultar información oficial de medicamentos veterinarios del registro CIMA Vet." schemaType="AboutPage">
<main class="presentation-page">
  <section class="presentation-hero" aria-labelledby="presentation-title"><div class="presentation-hero-copy">
    <span class="page-eyebrow"><span class="icon-container page-eyebrow-icon"><i class="ph ph-paw-print" aria-hidden="true"></i></span> Medicamentos veterinarios</span>
    <h1 id="presentation-title">La información de cada medicamento, más fácil de consultar.</h1>
    <p class="presentation-lead"><span class="logo-colored">VET lens</span> está desarrollando una app para acercar, de forma clara y desde el móvil, información oficial sobre medicamentos veterinarios.</p>
    <p>El proyecto toma como referencia los datos públicos de CIMA Vet, el registro de medicamentos veterinarios de la AEMPS.</p>
    <p class="launch-status"><i class="ph ph-hammer" aria-hidden="true"></i><strong>Próximamente</strong><span>La app está en desarrollo.</span></p>
  </div><aside class="presentation-data" aria-label="Fuente de información veterinaria"><div class="presentation-data-top"><span class="icon-container"><i class="ph ph-database" aria-hidden="true"></i></span><span>La base de datos de CIMA Vet incluye</span></div><div class="presentation-stats" aria-label="Datos del catálogo de CIMA Vet"><div><strong>+2.400</strong><span>Medicamentos</span></div><div><strong>+1.100</strong><span>Principios activos</span></div><div><strong>+4.200</strong><span>Presentaciones</span></div></div><p class="presentation-data-note">Cifras aproximadas del catálogo oficial de CIMA Vet.</p></aside></section>
  <section class="presentation-documents" aria-labelledby="documents-title"><header class="presentation-section-heading"><span class="page-eyebrow">Documentación oficial</span><h2 id="documents-title">Consulta la información autorizada</h2><p>CIMA Vet incluye documentos de referencia dirigidos tanto a profesionales veterinarios como a responsables de animales.</p></header>
    <div class="document-cards"><article class="document-card"><header class="document-card-header"><h3><span class="document-card-code document-card-code--prospectus" aria-hidden="true">P</span>Prospecto</h3></header><p>Información autorizada dirigida a las personas propietarias y responsables de los animales.</p></article><article class="document-card"><header class="document-card-header"><h3><span class="document-card-code document-card-code--technical" aria-hidden="true">FT</span>Ficha técnica</h3></header><p>Documento de referencia para profesionales veterinarios, con información sobre uso, especies, precauciones y seguridad.</p></article><article class="document-card"><header class="document-card-header"><h3><span class="document-card-code document-card-code--evaluation" aria-hidden="true">IPE</span>Evaluación</h3></header><p>Consulta la evaluación del medicamento como información complementaria a su ficha técnica y prospecto.</p></article></div>
  </section>
  <section class="presentation-details" aria-labelledby="details-title"><header class="presentation-section-heading"><span class="page-eyebrow">Cada medicamento, en detalle</span><h2 id="details-title">Información organizada para el ámbito veterinario</h2><p>La API de CIMA Vet contempla campos específicos para medicamentos veterinarios; la app está en desarrollo y su presentación final podrá ajustarse.</p></header>
    <div class="medicine-detail-grid">{medicineDetails.map((detail) => <article class="medicine-detail-card"><header class="medicine-detail-card-header"><span class="icon-container"><i class:list={['ph', detail.icon]} aria-hidden="true"></i></span><h3>{detail.title}</h3></header><ul>{detail.items.map((item) => <li>{item}</li>)}</ul></article>)}</div>
  </section>
  <section class="presentation-search" aria-labelledby="search-title"><div class="presentation-search-copy"><span class="page-eyebrow">Encuentra lo que necesitas</span><h2 id="search-title">Busca por datos veterinarios</h2><p>Estamos preparando una búsqueda basada en los campos del registro: medicamento, laboratorio, principios activos, registro, presentación y especie de destino.</p></div><div class="search-methods-wrap"><h3>Campos de búsqueda contemplados</h3><ul class="search-methods">{searchMethods.map((method) => <li>{method}</li>)}</ul></div></section>
  <section class="presentation-benefits" aria-labelledby="benefits-title"><header class="presentation-section-heading"><span class="page-eyebrow">El propósito</span><h2 id="benefits-title">Información oficial. Consulta más sencilla.</h2></header><div class="benefit-grid"><article><span class="icon-container"><i class="ph ph-book-open-text" aria-hidden="true"></i></span><h3>Fuente oficial</h3><p>El proyecto se basa en la información pública del registro veterinario de la AEMPS.</p></article><article><span class="icon-container"><i class="ph ph-paw-print" aria-hidden="true"></i></span><h3>Enfoque veterinario</h3><p>Especies, condiciones de uso y tiempos de espera forman parte de los datos que se preparan para consulta.</p></article><article><span class="icon-container"><i class="ph ph-device-mobile" aria-hidden="true"></i></span><h3>En desarrollo</h3><p>Estamos trabajando en una experiencia móvil clara y accesible. La app todavía no está disponible.</p></article></div></section>
  <section class="presentation-cta" aria-labelledby="presentation-cta-title"><div><span class="page-eyebrow">Próximamente</span><h2 id="presentation-cta-title">VET lens está en desarrollo</h2></div><a class="custom-button" href="/contacto">Contactar con el equipo <i class="ph ph-arrow-right" aria-hidden="true"></i></a><!-- Tiendas Android/iOS pendientes de publicación. --></section>
</main></SiteLayout>
