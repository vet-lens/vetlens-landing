---
import SiteLayout from '@/layouts/SiteLayout.astro';

const appHighlights = [
  { icon: 'ph-clock-counter-clockwise', title: 'Consulta de información oficial', text: 'Datos públicos de medicamentos veterinarios organizados para una consulta sencilla.' },
  { icon: 'ph-first-aid-kit', title: 'Información veterinaria', text: 'Consulta datos como especie de destino, presentaciones y condiciones de uso.' },
  { icon: 'ph-device-mobile', title: 'App en desarrollo', text: 'Preparamos una experiencia móvil clara y accesible para una futura publicación en Android e iOS.' },
];

const sponsorBenefits = [
  { icon: 'ph-globe', title: 'Presencia en web', text: 'Logo, enlace y nivel de colaboración en la página durante 12 meses.' },
  { icon: 'ph-device-mobile', title: 'Presencia en la app', text: 'Posibilidad de reconocimiento en la app cuando esté disponible, según el plan.' },
  { icon: 'ph-share-network', title: 'Difusión', text: 'Menciones en futuras comunicaciones del proyecto, según la modalidad.' },
  { icon: 'ph-megaphone', title: 'Campañas conjuntas', text: 'Participación en campañas educativas o de prevención, según el plan.' },
  { icon: 'ph-chart-line-up', title: 'Seguimiento del proyecto', text: 'Información general sobre la evolución del proyecto y sus avances.' },
];

const sponsorshipTiers = [
  { benefit: 'Presencia en web durante 12 meses', platinum: 'Logo destacado y enlace', gold: 'Logo y enlace', collaborator: 'Logo y enlace' },
  { benefit: 'Presencia en la app', platinum: 'Logo destacado en «Acerca de»', gold: 'Logo y enlace en «Acerca de»', collaborator: 'Nombre en «Acerca de»' },
  { benefit: 'Menciones en newsletter', platinum: 'Todas las ediciones', gold: '4 al año', collaborator: '—' },
  { benefit: 'Informe de uso agregado y anónimo', platinum: 'Trimestral y revisión anual', gold: 'Semestral', collaborator: '—' },
  { benefit: 'Campaña educativa conjunta', platinum: 'Prioridad: una al año', gold: 'Participación opcional', collaborator: '—' },
  { benefit: 'Agradecimiento en comunicación anual', platinum: 'Incluido', gold: 'Incluido', collaborator: 'Incluido' },
];

const sponsorshipPlans = [
  {
    key: 'collaborator',
    name: 'Colaborador',
    price: '<2.000 €/año',
    summary: 'Una forma sencilla de apoyar el proyecto.',
    highlights: ['Logo y enlace en la web durante 12 meses', 'Mención con el nombre en «Acerca de» de la app', 'Agradecimiento en la comunicación anual de avances'],
  },
  {
    key: 'gold',
    name: 'Oro',
    price: '2.000–5.000 €/año',
    summary: 'Presencia digital con opciones de colaboración flexibles.',
    highlights: ['Todo lo incluido en Colaborador', '4 menciones en newsletter al año', 'Logo y enlace en «Acerca de» de la app', 'Informe semestral de uso agregado y anónimo', 'Participación opcional en campañas educativas'],
  },
  {
    key: 'platinum',
    name: 'Platino',
    price: '+5.000 €/año',
    summary: 'La colaboración con mayor alcance y participación.',
    highlights: ['Todo lo incluido en Oro', 'Mención en todas las ediciones de la newsletter', 'Logo destacado en la app', 'Informe trimestral y revisión anual de uso agregado y anónimo', 'Prioridad para una campaña educativa conjunta al año'],
  },
];

const otherCollaborationWays = [
  { icon: 'ph-share-network', title: 'Difusión', text: 'Comparte VET lens con redes profesionales, asociaciones y comunidades.' },
  { icon: 'ph-first-aid-kit', title: 'Conocimiento veterinario', text: 'Participa en actividades educativas o revisa materiales divulgativos con independencia editorial.' },
  { icon: 'ph-globe', title: 'Accesibilidad y traducción', text: 'Ayuda a mejorar la lectura clara, la accesibilidad y la traducción de contenidos.' },
  { icon: 'ph-lightbulb', title: 'Recursos y espacios', text: 'Aporta horas profesionales, herramientas, créditos tecnológicos o espacios para actividades y pruebas.' },
];

const reasonsToPartner = [
  { icon: 'ph-heart', text: 'Promoción del bienestar animal y del acceso responsable a información veterinaria.' },
  { icon: 'ph-lightbulb', text: 'Asociación con la innovación social y la tecnología ética.' },
  { icon: 'ph-hand-heart', text: 'Participación en la mejora del acceso a información sobre medicamentos.' },
];
---

<SiteLayout
  title="Patrocina VET lens"
  seoTitle="Colabora con VET lens — Patrocinio"
  description="Conoce el proyecto VET lens y sus modalidades de patrocinio para colaborar en el acceso responsable a información oficial sobre medicamentos."
>
  <main class="sponsor-page">
    <section class="sponsor-hero" aria-labelledby="sponsor-title">
      <div class="sponsor-hero-copy">
        <span class="page-eyebrow"><span class="icon-container page-eyebrow-icon"><i class="ph ph-handshake" aria-hidden="true"></i></span> Colabora con el proyecto</span>
        <h1 id="sponsor-title">Patrocina <span class="logo-colored">VET lens</span></h1>
        <p class="sponsor-hero-lead">Buscamos patrocinadores comprometidos con el acceso responsable a la información sobre medicamentos veterinarios.</p>
        <a class="custom-button" href="/contacto">Hablar sobre patrocinio <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
      </div>
      <aside class="sponsor-hero-panel" aria-label="Características del proyecto">
        <div class="sponsor-hero-panel-heading">
          <span class="icon-container"><i class="ph ph-shield-check" aria-hidden="true"></i></span>
          <h2>Información clara y oficial</h2>
        </div>
        <p>VET lens está desarrollando una herramienta de consulta basada en los datos públicos de CIMA Vet, el registro veterinario de la AEMPS.</p>
        <ul>
          <li><i class="ph ph-check-circle" aria-hidden="true"></i> App próximamente</li>
          <li><i class="ph ph-check-circle" aria-hidden="true"></i> Información verificada</li>
          <li><i class="ph ph-check-circle" aria-hidden="true"></i> Uso responsable de los datos</li>
        </ul>
      </aside>
    </section>

    <section class="sponsor-section" aria-labelledby="sponsor-project-title">
      <header class="presentation-section-heading">
        <span class="page-eyebrow">El proyecto</span>
        <h2 id="sponsor-project-title">Una futura herramienta de consulta veterinaria</h2>
        <p><span class="logo-colored">VET lens</span> está en desarrollo. Preparamos una app para consultar información oficial de medicamentos veterinarios, como especies de destino, presentaciones, condiciones de uso, fichas técnicas y prospectos.</p>
      </header>
      <div class="sponsor-feature-grid">
        {appHighlights.map((item) => (
          <article class="sponsor-card">
            <span class="icon-container"><i class:list={['ph', item.icon]} aria-hidden="true"></i></span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
      <p class="sponsor-project-link">Descubre cómo funciona <a href="/presentamos-vet-lens">la presentación de VET lens <i class="ph ph-arrow-right" aria-hidden="true"></i></a></p>
    </section>

    <section class="sponsor-info-grid" aria-label="Público y estado del proyecto">
      <article class="sponsor-info-panel" aria-labelledby="sponsor-audience-title">
        <span class="page-eyebrow">A quién se dirige</span>
        <h2 id="sponsor-audience-title">Información para distintas personas</h2>
        <ul class="sponsor-audience-list">
          <li>Personas responsables de animales que buscan información veterinaria clara y oficial.</li>
          <li>Profesionales veterinarios.</li>
        </ul>
      </article>
      <article class="sponsor-info-panel" aria-labelledby="sponsor-status-title">
        <span class="page-eyebrow">Estado del proyecto</span>
        <h2 id="sponsor-status-title">En desarrollo activo</h2>
        <p>La futura app tomará como referencia los datos públicos del registro CIMA Vet de la AEMPS.</p>
        <a class="sponsor-text-link" href="/roadmap">Consulta la hoja de ruta <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
      </article>
    </section>

    <section class="sponsor-section" aria-labelledby="sponsor-benefits-title">
      <header class="presentation-section-heading">
        <span class="page-eyebrow">La colaboración</span>
        <h2 id="sponsor-benefits-title">Visibilidad y asociación con un propósito</h2>
        <p>Las modalidades de colaboración previstas se adaptarán a las necesidades del proyecto y a su futura puesta en marcha.</p>
      </header>
      <div class="sponsor-benefit-grid">
        {sponsorBenefits.map((item) => (
          <article class="sponsor-card">
            <span class="icon-container"><i class:list={['ph', item.icon]} aria-hidden="true"></i></span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="sponsor-section sponsor-tiers" aria-labelledby="sponsor-tiers-title">
      <header class="presentation-section-heading">
        <span class="page-eyebrow">Modalidades</span>
        <h2 id="sponsor-tiers-title">Elige cómo colaborar</h2>
        <p>Escoge el nivel que mejor encaje con tu colaboración. Puedes consultar las diferencias detalladas en la comparativa.</p>
      </header>
      <div class="sponsor-plan-grid">
        {sponsorshipPlans.map((plan) => (
          <article class="sponsor-plan-card" aria-labelledby={'sponsor-plan-' + plan.key}>
            <header>
              <h3 id={'sponsor-plan-' + plan.key}>{plan.name}</h3>
              <p class="sponsor-plan-price">{plan.price}</p>
            </header>
            <p class="sponsor-plan-summary">{plan.summary}</p>
            <ul>
              {plan.highlights.map((highlight) => (
                <li><i class="ph ph-check-circle" aria-hidden="true"></i>{highlight}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
      <details class="sponsor-comparison">
        <summary><span class="sponsor-comparison-closed">Mostrar comparativa</span><span class="sponsor-comparison-open">Ocultar comparativa</span></summary>
        <div class="sponsor-comparison-content">
          <div class="sponsor-table-wrap" tabindex="0" role="region" aria-labelledby="sponsor-tiers-title">
            <table class="sponsor-tier-table">
              <caption class="visually-hidden">Comparativa de beneficios por nivel de patrocinio</caption>
              <thead>
                <tr>
                  <th scope="col">Beneficio</th>
                  {sponsorshipPlans.map((plan) => (
                    <th scope="col"><span class="sponsor-tier-name">{plan.name}</span><span class="sponsor-tier-price">{plan.price}</span></th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {sponsorshipTiers.map((tier) => (
                  <tr>
                    <th scope="row">{tier.benefit}</th>
                    {sponsorshipPlans.map((plan) => <td>{tier[plan.key]}</td>)}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </details>
      <p class="sponsor-plan-principle">Cada modalidad cubre 12 meses. Las menciones y campañas se coordinan con el equipo. Los informes usan métricas agregadas y anónimas; no se comparten datos personales ni de salud.</p>
    </section>

    <section class="sponsor-section sponsor-other-ways" aria-labelledby="sponsor-other-ways-title">
      <header class="presentation-section-heading">
        <span class="page-eyebrow">Otras formas de colaborar</span>
        <h2 id="sponsor-other-ways-title">También puedes aportar tiempo, conocimiento o recursos</h2>
        <p>Si ahora no encaja un patrocinio económico, hay otras maneras de ayudar a que el proyecto llegue más lejos.</p>
      </header>
      <div class="sponsor-support-grid">
        {otherCollaborationWays.map((item) => (
          <article class="sponsor-support-card">
            <span class="icon-container"><i class:list={['ph', item.icon]} aria-hidden="true"></i></span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="sponsor-section sponsor-reasons" aria-labelledby="sponsor-reasons-title">
      <header class="presentation-section-heading">
        <span class="page-eyebrow">Por qué colaborar</span>
        <h2 id="sponsor-reasons-title">Un proyecto con impacto social</h2>
      </header>
      <div class="sponsor-reason-grid">
        {reasonsToPartner.map((reason) => (
          <article class="sponsor-reason-card">
            <span class="icon-container"><i class:list={['ph', reason.icon]} aria-hidden="true"></i></span>
            <p>{reason.text}</p>
          </article>
        ))}
      </div>
      <p class="sponsor-project-note"><span class="logo-colored">VET lens</span> es un proyecto independiente, comprometido con el acceso libre, verificado y fácil a la información sobre medicamentos veterinarios. Utiliza datos oficiales de la AEMPS.</p>
    </section>

    <aside class="sponsor-cta" aria-labelledby="sponsor-contact-title">
      <div>
        <span class="page-eyebrow">Contacto</span>
        <h2 id="sponsor-contact-title">¿Hablamos de colaboración?</h2>
        <p>Escríbenos y cuéntanos qué tienes en mente.</p>
      </div>
      <a class="custom-button" href="/contacto">Ir al formulario de contacto <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
    </aside>
  </main>
</SiteLayout>
